# Development only; do not commit .env
NODE_ENV=development
PORT=3001

# windows = current Windows identity (uses installed ODBC Driver 17 or 18 for SQL Server)
# sql = SQL Server Authentication (requires DB_USER, DB_PASSWORD)
DB_AUTH_MODE=windows
DB_SERVER=localhost
DB_DATABASE=GocDanSinh
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_USER=
DB_PASSWORD=

# At least 24 random characters, use only for local developer preview
DEV_PREVIEW_KEY=GENERATED_BY_SETUP_SCRIPT
